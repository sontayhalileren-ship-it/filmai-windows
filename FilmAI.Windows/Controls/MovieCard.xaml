<UserControl
    x:Class="FilmAI.Windows.Controls.MovieCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FilmAI.Windows.Models">

    <Border Style="{StaticResource MovieCardBorderStyle}" Width="180" PointerPressed="OnPointerPressed">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="270" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Poster 2:3 oran -->
            <Grid Grid.Row="0" CornerRadius="8,8,0,0">
                <Image Source="{x:Bind Movie.PosterPath, Mode=OneWay}" Stretch="UniformToFill" />

                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                        Style="{StaticResource RatingBadgeBorderStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{StaticResource GoldAccentBrush}" />
                        <TextBlock Text="{x:Bind Movie.Rating, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                        Visibility="{x:Bind Movie.IsHiddenGem, Mode=OneWay}"
                        Style="{StaticResource RatingBadgeBorderStyle}">
                    <TextBlock Text="Gizli Cevher" Style="{StaticResource CaptionTextStyle}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Padding="8" Spacing="2">
                <TextBlock Text="{x:Bind Movie.Title, Mode=OneWay}"
                           Style="{StaticResource BodyTextStyle}"
                           FontWeight="SemiBold"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Movie.ReleaseDate.Year, Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
