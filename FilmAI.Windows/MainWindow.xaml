<Window
    x:Class="FilmAI.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <NavigationView
            x:Name="RootNavigationView"
            IsBackButtonVisible="Auto"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            ItemInvoked="RootNavigationView_ItemInvoked"
            BackRequested="RootNavigationView_BackRequested">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Anasayfa" Tag="Home" Icon="Home" />
                <NavigationViewItem Content="Keşfet" Tag="Discover" Icon="Filter" />
                <NavigationViewItem Content="İzleme Listem" Tag="Watchlist" Icon="List" />
                <!-- NOT: Kasıtlı olarak "AI Assistant" sekmesi yok. -->
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
