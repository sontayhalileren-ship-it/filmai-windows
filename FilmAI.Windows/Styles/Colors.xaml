<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ana Arka Plan -->
    <Color x:Key="AppBackgroundColor">#121212</Color>
    <Color x:Key="AppBackgroundAltColor">#18181B</Color>

    <!-- Kart Yüzeyleri -->
    <Color x:Key="CardSurfaceColor">#202024</Color>
    <Color x:Key="CardSurfaceHoverColor">#28282D</Color>

    <!-- İnce sınırlar -->
    <Color x:Key="SubtleBorderColor">#2D2D30</Color>

    <!-- Accent: Sinematik Kırmızı (birincil) / IMDb Altın Sarısı (rozetler) -->
    <Color x:Key="AccentColor">#E50914</Color>
    <Color x:Key="GoldAccentColor">#F5C518</Color>

    <Color x:Key="TextPrimaryColor">#F5F5F5</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceHoverBrush" Color="{StaticResource CardSurfaceHoverColor}" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="GoldAccentBrush" Color="{StaticResource GoldAccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

</ResourceDictionary>
