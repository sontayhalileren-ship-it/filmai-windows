<Page
    x:Class="FilmAI.Windows.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FilmAI.Windows.Controls"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: Filtre Paneli (manuel, AI destekli doğal dil arama YOK) -->
        <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,24,0">
            <TextBlock Text="Filtreler" Style="{StaticResource SectionHeaderStyle}" />

            <TextBox PlaceholderText="Film adı ara..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <TextBlock Text="Tür" Style="{StaticResource CaptionTextStyle}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AvailableGenres}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding}" Checked="OnGenreChecked" Unchecked="OnGenreChecked" Tag="{Binding}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock Text="Minimum Puan" Style="{StaticResource CaptionTextStyle}" />
            <Slider Minimum="0" Maximum="10" StepFrequency="0.5" Value="{x:Bind ViewModel.MinRating, Mode=TwoWay}" />

            <TextBlock Text="Yönetmen" Style="{StaticResource CaptionTextStyle}" />
            <TextBox Text="{x:Bind ViewModel.Director, Mode=TwoWay}" />

            <TextBlock Text="Sıralama" Style="{StaticResource CaptionTextStyle}" />
            <ComboBox SelectedIndex="0" Width="220">
                <ComboBoxItem Content="Popülerlik" />
                <ComboBoxItem Content="IMDb Puanı" />
                <ComboBoxItem Content="Yeni Eklenenler" />
                <ComboBoxItem Content="İsim (A-Z)" />
            </ComboBox>

            <Button Content="Uygula" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
            <Button Content="Filtreleri Temizle" Command="{x:Bind ViewModel.ClearFiltersCommand}" />
        </StackPanel>

        <!-- Sağ: Sonuç Grid'i -->
        <GridView Grid.Column="1" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                  SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <controls:MovieCard Movie="{Binding}" Clicked="OnMovieCardClicked" Margin="0,0,12,12" />
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>
</Page>
