<Page
    x:Class="FilmAI.Windows.Views.MovieDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FilmAI.Windows.Controls"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer>
        <StackPanel>

            <!-- Hero -->
            <Grid Height="360">
                <Image Source="{x:Bind ViewModel.Movie.BackdropPath, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.6" />
                <Grid Padding="32" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource MovieCardBorderStyle}" Width="160" Height="240" VerticalAlignment="Bottom">
                        <Image Source="{x:Bind ViewModel.Movie.PosterPath, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.Movie.Title, Mode=OneWay}" Style="{StaticResource HeroTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.Movie.ReleaseDate.Year, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Movie.RuntimeMinutes, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Movie.AgeRating, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource RatingBadgeBorderStyle}">
                                <TextBlock Text="{x:Bind ViewModel.Movie.Rating, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource GoldAccentBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Content="İzleme Listesine Ekle/Çıkar" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleWatchlistCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Padding="32" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Konu" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Movie.Overview, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Yönetmen ve Ekip" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Movie.Director, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Benzer Filmler" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SimilarMovies, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MovieCard Movie="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
