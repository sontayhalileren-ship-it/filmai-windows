<Page
    x:Class="FilmAI.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">

    <StackPanel Padding="24" Spacing="16" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Ayarlar" Style="{StaticResource SectionHeaderStyle}" />

        <TextBlock Text="Tema" Style="{StaticResource CaptionTextStyle}" />
        <ComboBox SelectedIndex="0" Width="220">
            <ComboBoxItem Content="Koyu (Varsayılan)" />
            <ComboBoxItem Content="Açık" />
        </ComboBox>

        <TextBlock Text="Veri Kaynağı" Style="{StaticResource CaptionTextStyle}" />
        <TextBlock Text="TMDB / IMDb API anahtarı (yakında)" Style="{StaticResource BodyTextStyle}" />

        <!-- NOT: Bu sayfada kasıtlı olarak hiçbir AI sağlayıcı (Claude/Gemini) API anahtar alanı yoktur. -->
    </StackPanel>
</Page>
