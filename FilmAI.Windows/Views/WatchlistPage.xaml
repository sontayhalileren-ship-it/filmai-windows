<Page
    x:Class="FilmAI.Windows.Views.WatchlistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FilmAI.Windows.Controls"
    Background="{ThemeResource AppBackgroundBrush}">

    <StackPanel Padding="24" Spacing="16">
        <TextBlock Text="İzleme Listem" Style="{StaticResource SectionHeaderStyle}" />

        <GridView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <controls:MovieCard Movie="{Binding}" Clicked="OnMovieCardClicked" Margin="0,0,12,12" />
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </StackPanel>
</Page>
